{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cricket-dashboard",
      "runtimeExecutable": ".venv\\Scripts\\streamlit.exe",
      "runtimeArgs": [
        "run",
        "dashboard/app.py",
        "--server.port", "8503",
        "--server.headless", "true"
      ],
      "port": 8503
    },
    {
      "name": "Streamlit Dashboard",
      "runtimeExecutable": ".venv\\Scripts\\streamlit.exe",
      "runtimeArgs": [
        "run",
        "dashboard/app.py",
        "--server.port", "8501",
        "--server.headless", "true"
      ],
      "port": 8501
    },
    {
      "name": "Cricket CLI (modules)",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "-m",
        "cricket_analytics.cli",
        "modules"
      ],
      "port": 0
    }
  ]
}
